{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@context7-marketplace": true,
    "ponytail@ponytail": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$file\" ] && [ -x \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" ]; then \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown -- \"$file\" >/dev/null; fi"
          }
        ]
      }
    ]
  }
}
