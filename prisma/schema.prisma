// Base schema Milestone 1 (docs/DATABASE.md §1, D-028).
generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RoleScope {
  GLOBAL
  PROJECT
}

model User {
  id            String   @id @default(uuid(7)) @db.Char(36)
  name          String   @db.VarChar(150)
  /// Normalized (trim + lowercase) before write; uniqueness enforced here.
  email         String   @unique @db.VarChar(254)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  isSystemAdmin Boolean  @default(false) @map("is_system_admin")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sessions              AuthSession[]
  memberships           ProjectUser[]        @relation("MembershipUser")
  createdMemberships    ProjectUser[]        @relation("MembershipCreatedBy")
  revokedMemberships    ProjectUser[]        @relation("MembershipRevokedBy")
  globalRoles           UserGlobalRole[]     @relation("GlobalRoleUser")
  createdGlobalRoles    UserGlobalRole[]     @relation("GlobalRoleCreatedBy")
  revokedGlobalRoles    UserGlobalRole[]     @relation("GlobalRoleRevokedBy")
  auditLogs             AuditLog[]
  createdRabVersions    RabVersion[]         @relation("RabVersionCreatedBy")
  createdBaselines      BaselineAssignment[] @relation("BaselineCreatedBy")
  revokedBaselines      BaselineAssignment[] @relation("BaselineRevokedBy")
  approvedRabVersions   RabVersion[]         @relation("RabVersionApprovedBy")
  discardedRabVersions  RabVersion[]         @relation("RabVersionDiscardedBy")
  uploadedDocuments     ProjectDocument[]
  createdImports        RabImport[]          @relation("ImportCreatedBy")
  approvedImports       RabImport[]          @relation("ImportApprovedBy")
  rejectedImports       RabImport[]          @relation("ImportRejectedBy")
  importDecisions       RabImportDecision[]
  createdPriceLists     PriceList[]
  priceDecisions        RabVersionItem[]     @relation("ItemPriceDecidedBy")
  approvedSnapshots     RabVersionSnapshot[] @relation("SnapshotApprovedBy")
  createdSnapshots      RabVersionSnapshot[] @relation("SnapshotCreatedBy")
  createdSchedules      ScheduleVersion[]    @relation("ScheduleCreatedBy")
  createdScenarios      ScheduleScenario[]   @relation("ScenarioCreatedBy")
  updatedScenarios      ScheduleScenario[]   @relation("ScenarioUpdatedBy")
  approvedSchedules     ScheduleVersion[]    @relation("ScheduleApprovedBy")
  enteredProgress       WeeklyProgress[]     @relation("ProgressEnteredBy")
  updatedProgress       WeeklyProgress[]     @relation("ProgressUpdatedBy")
  createdDailyReports   DailyReport[]        @relation("DailyReportCreatedBy")
  updatedDailyReports   DailyReport[]        @relation("DailyReportUpdatedBy")
  finalizedDailyReports DailyReport[]        @relation("DailyReportFinalizedBy")
  dailyAllocations      DailyAllocation[]    @relation("DailyAllocationUpdatedBy")
  createdWorkers        Worker[]             @relation("WorkerCreatedBy")
  updatedWorkers        Worker[]             @relation("WorkerUpdatedBy")
  submittedWeekly       WeeklyReport[]       @relation("WeeklySubmittedBy")
  reviewedWeekly        WeeklyReport[]       @relation("WeeklyReviewedBy")
  finalizedWeekly       WeeklyReport[]       @relation("WeeklyFinalizedBy")
  weeklySnapshots       WeeklyReportSnapshot[]
  reportTemplates       ReportTemplate[]
  reportLogos           ProjectLogo[]
  reportWorkbooks       ReportWorkbook[]

  @@index([isSystemAdmin, isActive])
  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// SHA-256 hex of the session token; the raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model Project {
  id              String        @id @default(uuid(7)) @db.Char(36)
  code            String        @unique @db.VarChar(50)
  activityName    String        @map("activity_name") @db.VarChar(255)
  subActivityName String        @map("sub_activity_name") @db.VarChar(255)
  projectName     String        @map("project_name") @db.VarChar(500)
  location        String        @db.VarChar(255)
  fiscalYear      Int           @map("fiscal_year") @db.UnsignedSmallInt
  contractorName  String        @map("contractor_name") @db.VarChar(255)
  consultantName  String        @map("consultant_name") @db.VarChar(255)
  contractNumber  String        @map("contract_number") @db.VarChar(100)
  contractDate    DateTime      @map("contract_date") @db.Date
  /// Required by the API; null only for projects created before Milestone 3 (D-039).
  contractValue   Decimal?      @map("contract_value") @db.Decimal(20, 2)
  spmkNumber      String        @map("spmk_number") @db.VarChar(100)
  spmkDate        DateTime      @map("spmk_date") @db.Date
  startDate       DateTime      @map("start_date") @db.Date
  /// Planned finish date is derived (start + duration − 1) and not stored (D-036).
  durationDays    Int           @map("duration_days") @db.UnsignedSmallInt
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  members             ProjectUser[]
  auditLogs           AuditLog[]
  weeks               ProjectWeek[]
  reportPeriods       ReportPeriod[]
  rabVersions         RabVersion[]
  baselineAssignments BaselineAssignment[]
  workItems           WorkItem[]
  documents           ProjectDocument[]
  rabImports          RabImport[]
  priceLists          PriceList[]
  analyses            AhspAnalysis[]
  schedules           ScheduleVersion[]
  scheduleScenarios   ScheduleScenario[]
  weeklyProgress      WeeklyProgress[]
  dailyReports        DailyReport[]
  weeklyReports       WeeklyReport[]
  reportTemplates     ReportTemplate[]
  reportLogos         ProjectLogo[]
  reportWorkbooks     ReportWorkbook[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// 7-day blocks from the project start; the last one ends on the planned finish date (D-037).
model ProjectWeek {
  id             String   @id @default(uuid(7)) @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  reportPeriodId String   @map("report_period_id") @db.Char(36)
  weekNumber     Int      @map("week_number") @db.UnsignedSmallInt
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reportPeriod    ReportPeriod     @relation(fields: [reportPeriodId], references: [id], onDelete: Restrict)
  scheduleEntries ScheduleEntry[]
  progress        WeeklyProgress[]
  dailyReports    DailyReport[]
  weeklyReport    WeeklyReport?

  @@unique([projectId, weekNumber])
  @@index([reportPeriodId])
  @@map("weeks")
}

/// 4-week blocks (B.n = weeks 4n−3..4n); the last one may be shorter than 28 days (D-037).
model ReportPeriod {
  id           String   @id @default(uuid(7)) @db.Char(36)
  projectId    String   @map("project_id") @db.Char(36)
  periodNumber Int      @map("period_number") @db.UnsignedSmallInt
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  weeks   ProjectWeek[]

  @@unique([projectId, periodNumber])
  @@map("report_periods")
}

/// Roles are data (D-035). System roles: code, scope, and isActive are locked.
model Role {
  id          String    @id @default(uuid(7)) @db.Char(36)
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  /// Inactive roles grant no permissions.
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  permissions       RolePermission[]
  memberships       ProjectUser[]
  globalAssignments UserGlobalRole[]

  @@map("roles")
}

/// permission_code refers to the code catalog in packages/shared (PERMISSIONS).
model RolePermission {
  roleId         String   @map("role_id") @db.Char(36)
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model ProjectUser {
  id        String    @id @default(uuid(7)) @db.Char(36)
  projectId String    @map("project_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// Must reference a PROJECT-scoped role (enforced in the service).
  roleId    String    @map("role_id") @db.Char(36)
  createdBy String?   @map("created_by") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// Soft revoke (D-029); active membership = revokedAt IS NULL.
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  revokedBy String?   @map("revoked_by") @db.Char(36)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user          User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User?   @relation("MembershipRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("project_users")
}

/// Administration role assignment without a project (D-035). Must reference a GLOBAL-scoped role.
model UserGlobalRole {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  roleId    String    @map("role_id") @db.Char(36)
  createdBy String?   @map("created_by") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  revokedBy String?   @map("revoked_by") @db.Char(36)

  user          User  @relation("GlobalRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("GlobalRoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("GlobalRoleRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_global_roles")
}

/// Append-only. Never store passwords, hashes, tokens, or secrets (D-034).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Char(36)
  projectId  String?  @map("project_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Char(36)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor   User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One Kontrak, then MC-0 … MC-100 (D-069).
enum RabVersionType {
  CONTRACT
  MC
}

enum RabVersionStatus {
  DRAFT
  APPROVED
  DISCARDED
  /// Approved version opened again for correction; same id/type/number (D-068).
  REOPENED
}

/// Stored row types; SUBTOTAL/TOTAL are computed for display (D-040).
enum RabRowType {
  SECTION
  SUBSECTION
  PARENT_ITEM
  ITEM
}

/// One RAB version per document; APPROVED/DISCARDED rows are never changed (D-040) except through the
/// D-068 reopen (snapshot archived first, reason + audit, approval again).
model RabVersion {
  id                String           @id @default(uuid(7)) @db.Char(36)
  projectId         String           @map("project_id") @db.Char(36)
  versionType       RabVersionType   @map("version_type")
  /// 0 for CONTRACT; the MC number (0 … 100) for MC (D-069).
  revisionNumber    Int              @map("revision_number") @db.UnsignedSmallInt
  documentNumber    String?          @map("document_number") @db.VarChar(100)
  documentDate      DateTime?        @map("document_date") @db.Date
  /// Approved version this one was copied from.
  previousVersionId String?          @map("previous_version_id") @db.Char(36)
  status            RabVersionStatus @default(DRAFT)
  /// Exact snapshot at approval (D-043); drafts are computed on read.
  totalBeforeTax    Decimal?         @map("total_before_tax") @db.Decimal(50, 18)
  totalTax          Decimal?         @map("total_tax") @db.Decimal(50, 18)
  totalValue        Decimal?         @map("total_value") @db.Decimal(50, 18)
  createdBy         String           @map("created_by") @db.Char(36)
  approvedBy        String?          @map("approved_by") @db.Char(36)
  approvedAt        DateTime?        @map("approved_at") @db.DateTime(3)
  discardedBy       String?          @map("discarded_by") @db.Char(36)
  discardedAt       DateTime?        @map("discarded_at") @db.DateTime(3)
  discardReason     String?          @map("discard_reason") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previousVersion     RabVersion?          @relation("RabVersionChain", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions        RabVersion[]         @relation("RabVersionChain")
  createdByUser       User                 @relation("RabVersionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedByUser      User?                @relation("RabVersionApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  discardedByUser     User?                @relation("RabVersionDiscardedBy", fields: [discardedBy], references: [id], onDelete: Restrict)
  items               RabVersionItem[]
  baselineAssignments BaselineAssignment[]
  sourceImports       RabImport[]
  /// Analysis/price package owned by this version (D-056, D-057).
  priceList           PriceList?
  analyses            AhspAnalysis[]
  snapshots           RabVersionSnapshot[]
  schedule            ScheduleVersion?

  @@index([projectId, status])
  @@map("rab_versions")
}

enum BaselineActivationMode {
  NEXT_WEEK
  EXACT_DATE
}

/// D-071: the RAB version in force from `effective_from` until the next live assignment (or the project end).
/// The only source of truth for the baseline per date; week segments are computed. Revoked rows stay (history).
model BaselineAssignment {
  id             String                 @id @default(uuid(7)) @db.Char(36)
  projectId      String                 @map("project_id") @db.Char(36)
  rabVersionId   String                 @map("rab_version_id") @db.Char(36)
  effectiveFrom  DateTime               @map("effective_from") @db.Date
  activationMode BaselineActivationMode @map("activation_mode")
  reason         String?                @db.Text
  createdBy      String                 @map("created_by") @db.Char(36)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt      DateTime?              @map("revoked_at") @db.DateTime(3)
  revokedBy      String?                @map("revoked_by") @db.Char(36)
  revokeReason   String?                @map("revoke_reason") @db.Text

  project       Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rabVersion    RabVersion @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  createdByUser User       @relation("BaselineCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User?      @relation("BaselineRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([projectId, effectiveFrom])
  @@index([rabVersionId])
  @@map("baseline_assignments")
}

enum ScheduleStatus {
  DRAFT
  APPROVED
  /// Approved schedule opened again for revision; entries before reopen are in the audit log (D-072).
  REOPENED
}

/// D-072: one time schedule per approved RAB version, in % of project weight per RAB group per week.
model ScheduleVersion {
  id               String         @id @default(uuid(7)) @db.Char(36)
  projectId        String         @map("project_id") @db.Char(36)
  rabVersionId     String         @unique @map("rab_version_id") @db.Char(36)
  status           ScheduleStatus @default(DRAFT)
  /// Last imported workbook; null when filled by hand only.
  sourceDocumentId String?        @map("source_document_id") @db.Char(36)
  createdBy        String         @map("created_by") @db.Char(36)
  approvedBy       String?        @map("approved_by") @db.Char(36)
  approvedAt       DateTime?      @map("approved_at") @db.DateTime(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rabVersion     RabVersion         @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  sourceDocument ProjectDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  createdByUser  User               @relation("ScheduleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedByUser User?              @relation("ScheduleApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  entries        ScheduleEntry[]
  scenarios      ScheduleScenario[]

  @@index([projectId])
  @@map("schedule_versions")
}

/// Planned % of project weight for one RAB group in one project week; only non-zero values are stored.
model ScheduleEntry {
  id                String  @id @default(uuid(7)) @db.Char(36)
  scheduleVersionId String  @map("schedule_version_id") @db.Char(36)
  /// SUBSECTION, or SECTION without SUBSECTION (scheduleGroupIds).
  groupItemId       String  @map("group_item_id") @db.Char(36)
  weekId            String  @map("week_id") @db.Char(36)
  plannedWeight     Decimal @map("planned_weight") @db.Decimal(30, 18)

  scheduleVersion ScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)
  groupItem       RabVersionItem  @relation(fields: [groupItemId], references: [id], onDelete: Restrict)
  week            ProjectWeek     @relation(fields: [weekId], references: [id], onDelete: Restrict)

  @@unique([scheduleVersionId, groupItemId, weekId])
  @@index([groupItemId])
  @@index([weekId])
  @@map("schedule_entries")
}

/// D-078: a named what-if copy of a schedule's entries; may run past the project end (weekCount).
model ScheduleScenario {
  id                String   @id @default(uuid(7)) @db.Char(36)
  projectId         String   @map("project_id") @db.Char(36)
  scheduleVersionId String   @map("schedule_version_id") @db.Char(36)
  name              String   @db.VarChar(120)
  weekCount         Int      @map("week_count") @db.UnsignedSmallInt
  createdBy         String   @map("created_by") @db.Char(36)
  updatedBy         String   @map("updated_by") @db.Char(36)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  scheduleVersion ScheduleVersion         @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)
  createdByUser   User                    @relation("ScenarioCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User                    @relation("ScenarioUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  entries         ScheduleScenarioEntry[]

  @@index([projectId])
  @@index([scheduleVersionId])
  @@map("schedule_scenarios")
}

/// Week by number, not by `weeks` row: scenario weeks may lie past the project end.
model ScheduleScenarioEntry {
  id            String  @id @default(uuid(7)) @db.Char(36)
  scenarioId    String  @map("scenario_id") @db.Char(36)
  groupItemId   String  @map("group_item_id") @db.Char(36)
  weekNumber    Int     @map("week_number") @db.UnsignedSmallInt
  plannedWeight Decimal @map("planned_weight") @db.Decimal(30, 18)

  scenario  ScheduleScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  groupItem RabVersionItem   @relation(fields: [groupItemId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, groupItemId, weekNumber])
  @@index([groupItemId])
  @@map("schedule_scenario_entries")
}

enum ProgressInputMode {
  VOLUME_WEEK
  PERCENT_CUMULATIVE
}

/// D-075: DAILY_FACTOR is computed on read; MANUAL uses the rows in daily_allocations.
enum DailyAllocationMethod {
  DAILY_FACTOR
  MANUAL
}

/// D-073: realised volume of one work item in one project week (the fact); never deleted, changes are audited.
model WeeklyProgress {
  id              String                @id @default(uuid(7)) @db.Char(36)
  projectId       String                @map("project_id") @db.Char(36)
  weekId          String                @map("week_id") @db.Char(36)
  workItemId      String                @map("work_item_id") @db.Char(36)
  inputMode       ProgressInputMode     @map("input_mode")
  /// PERCENT_CUMULATIVE only: the percent as typed.
  inputPercentage Decimal?              @map("input_percentage") @db.Decimal(9, 6)
  actualVolume    Decimal               @map("actual_volume") @db.Decimal(30, 12)
  dailyMethod     DailyAllocationMethod @default(DAILY_FACTOR) @map("daily_method")
  note            String?               @db.Text
  enteredBy       String                @map("entered_by") @db.Char(36)
  enteredAt       DateTime              @default(now()) @map("entered_at") @db.DateTime(3)
  updatedBy       String                @map("updated_by") @db.Char(36)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  week             ProjectWeek       @relation(fields: [weekId], references: [id], onDelete: Restrict)
  workItem         WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  enteredByUser    User              @relation("ProgressEnteredBy", fields: [enteredBy], references: [id], onDelete: Restrict)
  updatedByUser    User              @relation("ProgressUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  dailyAllocations DailyAllocation[]

  @@unique([weekId, workItemId])
  @@index([projectId, workItemId])
  @@index([workItemId])
  @@map("weekly_progress")
}

/// D-075: manual daily volumes of one weekly progress row; kept (not deleted) when the row goes back to DAILY_FACTOR.
model DailyAllocation {
  id               String   @id @default(uuid(7)) @db.Char(36)
  weeklyProgressId String   @map("weekly_progress_id") @db.Char(36)
  workDate         DateTime @map("work_date") @db.Date
  volume           Decimal  @db.Decimal(30, 12)
  updatedBy        String   @map("updated_by") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  weeklyProgress WeeklyProgress @relation(fields: [weeklyProgressId], references: [id], onDelete: Restrict)
  updatedByUser  User           @relation("DailyAllocationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([weeklyProgressId, workDate])
  @@map("daily_allocations")
}

/// D-079: DRAFT → FINAL; REOPENED after a reopen with reason, then FINAL again.
enum DailyReportStatus {
  DRAFT
  FINAL
  REOPENED
}

enum WeatherCondition {
  CLEAR
  CLOUDY
  DRIZZLE
  RAIN
  OTHER
}

enum DailyResourceCategory {
  LABOR
  MATERIAL
  EQUIPMENT
}

/// D-079: one report per project date.
model DailyReport {
  id          String            @id @default(uuid(7)) @db.Char(36)
  projectId   String            @map("project_id") @db.Char(36)
  weekId      String            @map("week_id") @db.Char(36)
  reportDate  DateTime          @map("report_date") @db.Date
  status      DailyReportStatus @default(DRAFT)
  note        String?           @db.Text
  createdBy   String            @map("created_by") @db.Char(36)
  updatedBy   String            @map("updated_by") @db.Char(36)
  finalizedBy String?           @map("finalized_by") @db.Char(36)
  finalizedAt DateTime?         @map("finalized_at") @db.DateTime(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  project         Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  week            ProjectWeek           @relation(fields: [weekId], references: [id], onDelete: Restrict)
  createdByUser   User                  @relation("DailyReportCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser   User                  @relation("DailyReportUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  finalizedByUser User?                 @relation("DailyReportFinalizedBy", fields: [finalizedBy], references: [id], onDelete: Restrict)
  resources       DailyReportResource[]
  weather         DailyReportWeather[]
  work            DailyReportWork[]

  @@unique([projectId, reportDate])
  @@index([weekId])
  @@map("daily_reports")
}

/// Labor (count of people), material and equipment lines. `sourceKey` ties a line to the AHSP-calculated item
/// (price item id or "description|unit"); null for lines typed by hand.
model DailyReportResource {
  id                 String                @id @default(uuid(7)) @db.Char(36)
  dailyReportId      String                @map("daily_report_id") @db.Char(36)
  category           DailyResourceCategory
  sortOrder          Int                   @map("sort_order") @db.UnsignedSmallInt
  sourceKey          String?               @map("source_key") @db.VarChar(1100)
  name               String                @db.VarChar(500)
  unit               String?               @db.VarChar(30)
  /// Frozen at FINAL; while DRAFT the calculation is live.
  calculatedQuantity Decimal?              @map("calculated_quantity") @db.Decimal(30, 12)
  actualQuantity     Decimal?              @map("actual_quantity") @db.Decimal(30, 12)
  note               String?               @db.VarChar(1000)

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId, category, sortOrder])
  @@map("daily_report_resources")
}

model DailyReportWeather {
  id            String           @id @default(uuid(7)) @db.Char(36)
  dailyReportId String           @map("daily_report_id") @db.Char(36)
  sortOrder     Int              @map("sort_order") @db.UnsignedSmallInt
  condition     WeatherCondition
  /// "HH:MM"
  fromTime      String?          @map("from_time") @db.Char(5)
  toTime        String?          @map("to_time") @db.Char(5)
  note          String?          @db.VarChar(500)

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
  @@map("daily_report_weather")
}

/// Work volumes of the day, frozen at FINAL (D-079 butir 7).
model DailyReportWork {
  id            String  @id @default(uuid(7)) @db.Char(36)
  dailyReportId String  @map("daily_report_id") @db.Char(36)
  workItemId    String  @map("work_item_id") @db.Char(36)
  volume        Decimal @db.Decimal(30, 12)

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  workItem    WorkItem    @relation(fields: [workItemId], references: [id], onDelete: Restrict)

  @@unique([dailyReportId, workItemId])
  @@map("daily_report_work")
}

/// Append-only archive of each approved state (D-068); never updated or deleted, never recomputed from live data.
model RabVersionSnapshot {
  id           String    @id @default(uuid(7)) @db.Char(36)
  rabVersionId String    @map("rab_version_id") @db.Char(36)
  sequence     Int       @db.UnsignedSmallInt
  approvedBy   String?   @map("approved_by") @db.Char(36)
  approvedAt   DateTime? @map("approved_at") @db.DateTime(3)
  totalValue   Decimal?  @map("total_value") @db.Decimal(50, 18)
  /// Decimals as strings; see RabSnapshotPayload in packages/shared.
  payload      Json
  /// SHA-256 of the canonical (sorted-key) JSON of payload, not of MySQL's JSON key order.
  checksum     String    @db.Char(64)
  createdBy    String    @map("created_by") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  rabVersion     RabVersion @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  approvedByUser User?      @relation("SnapshotApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  createdByUser  User       @relation("SnapshotCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([rabVersionId, sequence])
  @@map("rab_version_snapshots")
}

/// Permanent identity of a trackable work item across versions (PRD §9).
model WorkItem {
  id                   String   @id @default(uuid(7)) @db.Char(36)
  projectId            String   @map("project_id") @db.Char(36)
  internalCode         String   @map("internal_code") @db.VarChar(20)
  canonicalDescription String   @map("canonical_description") @db.VarChar(1000)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionItems RabVersionItem[]
  progress     WeeklyProgress[]
  dailyWork    DailyReportWork[]

  @@unique([projectId, internalCode])
  @@map("work_items")
}

model RabVersionItem {
  id                    String         @id @default(uuid(7)) @db.Char(36)
  rabVersionId          String         @map("rab_version_id") @db.Char(36)
  /// ITEM rows only.
  workItemId            String?        @map("work_item_id") @db.Char(36)
  parentItemId          String?        @map("parent_item_id") @db.Char(36)
  sortOrder             Int            @map("sort_order") @db.UnsignedInt
  rowType               RabRowType     @map("row_type")
  displayNumber         String?        @map("display_number") @db.VarChar(30)
  description           String         @db.VarChar(1000)
  /// 12 decimals: office workbooks use long volumes to balance MC-0 totals (D-043).
  volume                Decimal?       @db.Decimal(30, 12)
  unit                  String?        @db.VarChar(30)
  /// Free-text "no analisa" until AHSP (M7).
  analysisCode          String?        @map("analysis_code") @db.VarChar(50)
  unitPrice             Decimal?       @map("unit_price") @db.Decimal(20, 2)
  taxPercent            Decimal?       @map("tax_percent") @db.Decimal(5, 2)
  /// Exact snapshot at approval (D-043); weights are derived from subtotals.
  unitPriceWithTax      Decimal?       @map("unit_price_with_tax") @db.Decimal(26, 6)
  subtotal              Decimal?       @db.Decimal(48, 18)
  previousVersionItemId String?        @map("previous_version_item_id") @db.Char(36)
  /// Linked analysis version (D-049/D-051); approved RAB keeps pointing at the version used then.
  analysisVersionId     String?        @map("analysis_version_id") @db.Char(36)
  priceSource           RabPriceSource @default(MANUAL) @map("price_source")
  sourceUnitPrice       Decimal?       @map("source_unit_price") @db.Decimal(40, 12)
  analysisUnitPrice     Decimal?       @map("analysis_unit_price") @db.Decimal(40, 12)
  priceNote             String?        @map("price_note") @db.Text
  priceDecidedBy        String?        @map("price_decided_by") @db.Char(36)
  priceDecidedAt        DateTime?      @map("price_decided_at") @db.DateTime(3)
  /// Document/sheet/row of the imported source row.
  sourceLocator         Json?          @map("source_locator")
  createdAt             DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  analysisVersion     AhspAnalysisVersion?    @relation(fields: [analysisVersionId], references: [id], onDelete: Restrict)
  priceDecidedByUser  User?                   @relation("ItemPriceDecidedBy", fields: [priceDecidedBy], references: [id], onDelete: Restrict)
  rabVersion          RabVersion              @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  workItem            WorkItem?               @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  parent              RabVersionItem?         @relation("RabItemTree", fields: [parentItemId], references: [id], onDelete: Restrict)
  children            RabVersionItem[]        @relation("RabItemTree")
  previousVersionItem RabVersionItem?         @relation("RabItemCopy", fields: [previousVersionItemId], references: [id], onDelete: Restrict)
  copies              RabVersionItem[]        @relation("RabItemCopy")
  scheduleEntries     ScheduleEntry[]
  scenarioEntries     ScheduleScenarioEntry[]

  @@unique([rabVersionId, workItemId])
  @@index([rabVersionId, parentItemId, sortOrder])
  @@index([analysisVersionId])
  @@map("rab_version_items")
}

/// How an item's unit price was set (D-051).
enum RabPriceSource {
  MANUAL
  ANALYSIS
  SOURCE_OVERRIDE
  DIRECT
}

/// Original uploaded file; stored on disk under storage/projects/<project>/documents (D-049).
model ProjectDocument {
  id               String   @id @default(uuid(7)) @db.Char(36)
  projectId        String   @map("project_id") @db.Char(36)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  storedFilename   String   @unique @map("stored_filename") @db.VarChar(80)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  fileSize         Int      @map("file_size") @db.UnsignedInt
  sha256           String   @db.Char(64)
  /// Sheets that look like a RAB, computed once at upload (choice of rab_sheet).
  sheetInventory   Json?    @map("sheet_inventory")
  uploadedBy       String   @map("uploaded_by") @db.Char(36)
  uploadedAt       DateTime @default(now()) @map("uploaded_at") @db.DateTime(3)

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploader        User                @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  imports         RabImportDocument[]
  scheduleImports ScheduleVersion[]

  @@index([projectId])
  @@index([sha256])
  @@map("project_documents")
}

enum RabImportStatus {
  UPLOADED
  PROCESSING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
}

/// One import run of a document package into one target RAB version (D-048).
model RabImport {
  id                   String          @id @default(uuid(7)) @db.Char(36)
  projectId            String          @map("project_id") @db.Char(36)
  targetVersionType    RabVersionType  @map("target_version_type")
  /// MC number the run imports (0 for CONTRACT), fixed at creation (D-069).
  targetRevisionNumber Int             @default(0) @map("target_revision_number") @db.UnsignedSmallInt
  status               RabImportStatus @default(UPLOADED)
  attemptNumber        Int             @default(1) @map("attempt_number") @db.UnsignedSmallInt
  previousImportId     String?         @map("previous_import_id") @db.Char(36)
  guideVersion         String          @map("guide_version") @db.VarChar(40)
  parserVersion        String          @map("parser_version") @db.VarChar(40)
  /// Structured draft validated by the shared zod schema.
  draft                Json?
  errorMessage         String?         @map("error_message") @db.Text
  createdBy            String          @map("created_by") @db.Char(36)
  createdAt            DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  processedAt          DateTime?       @map("processed_at") @db.DateTime(3)
  approvedBy           String?         @map("approved_by") @db.Char(36)
  approvedAt           DateTime?       @map("approved_at") @db.DateTime(3)
  rejectedBy           String?         @map("rejected_by") @db.Char(36)
  rejectedAt           DateTime?       @map("rejected_at") @db.DateTime(3)
  rejectReason         String?         @map("reject_reason") @db.Text
  deletedAt            DateTime?       @map("deleted_at") @db.DateTime(3)
  rabVersionId         String?         @map("rab_version_id") @db.Char(36)
  priceListId          String?         @unique @map("price_list_id") @db.Char(36)

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previousImport   RabImport?            @relation("ImportRetry", fields: [previousImportId], references: [id], onDelete: Restrict)
  retries          RabImport[]           @relation("ImportRetry")
  creator          User                  @relation("ImportCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver         User?                 @relation("ImportApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  rejecter         User?                 @relation("ImportRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict)
  rabVersion       RabVersion?           @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  priceList        PriceList?            @relation("ImportPriceList", fields: [priceListId], references: [id], onDelete: Restrict)
  documents        RabImportDocument[]
  decisions        RabImportDecision[]
  aiRuns           AiRun[]
  analysisVersions AhspAnalysisVersion[]

  @@index([projectId, status])
  @@map("rab_imports")
}

model RabImportDocument {
  importId   String       @map("import_id") @db.Char(36)
  documentId String       @map("document_id") @db.Char(36)
  /// RAB = main RAB/recap document; SUPPORT = analysis/price document (D-055).
  role       DocumentRole @default(RAB)
  rabSheet   String?      @map("rab_sheet") @db.VarChar(120)
  /// D-090: reviewer-corrected column mapping (rabColumnMapSchema) for a sheet read by header words.
  columnMap  Json?        @map("column_map")
  sortOrder  Int          @default(0) @map("sort_order") @db.UnsignedSmallInt

  import   RabImport       @relation(fields: [importId], references: [id], onDelete: Restrict)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([importId, documentId])
  @@index([documentId])
  @@map("rab_import_documents")
}

enum DocumentRole {
  RAB
  SUPPORT
}

enum RabImportDecisionKind {
  ANALYSIS_LINK
  PRICE_CHOICE
  DIRECT_PRICE
  WORK_ITEM_MATCH
}

/// Reviewer decisions, append-only; the latest per row and kind applies.
model RabImportDecision {
  id        String                @id @default(uuid(7)) @db.Char(36)
  importId  String                @map("import_id") @db.Char(36)
  rowKey    String                @map("row_key") @db.VarChar(100)
  kind      RabImportDecisionKind
  value     Json
  reason    String?               @db.Text
  decidedBy String                @map("decided_by") @db.Char(36)
  decidedAt DateTime              @default(now()) @map("decided_at") @db.DateTime(3)

  import  RabImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  decider User      @relation(fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([importId, rowKey, kind])
  @@map("rab_import_decisions")
}

enum AiRunStatus {
  SUCCEEDED
  FAILED
}

/// Every model call (D-052): actual model, attempt, instruction version. Never contains the API key.
model AiRun {
  id                 String      @id @default(uuid(7)) @db.Char(36)
  importId           String      @map("import_id") @db.Char(36)
  purpose            String      @db.VarChar(60)
  instructionVersion String      @map("instruction_version") @db.VarChar(40)
  model              String      @db.VarChar(120)
  attempt            Int         @db.UnsignedSmallInt
  status             AiRunStatus
  error              String?     @db.Text
  response           Json?
  startedAt          DateTime    @map("started_at") @db.DateTime(3)
  finishedAt         DateTime    @map("finished_at") @db.DateTime(3)

  import RabImport @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@index([importId])
  @@map("ai_runs")
}

/// Versioned per-project price list created by an approved import (D-050).
model PriceList {
  id            String   @id @default(uuid(7)) @db.Char(36)
  projectId     String   @map("project_id") @db.Char(36)
  /// Owner of the package (D-057): one price list per RAB version.
  rabVersionId  String   @unique @map("rab_version_id") @db.Char(36)
  versionNumber Int      @map("version_number") @db.UnsignedSmallInt
  location      String?  @db.VarChar(255)
  period        String?  @db.VarChar(100)
  createdBy     String   @map("created_by") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project          Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rabVersion       RabVersion            @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  creator          User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  sourceImport     RabImport?            @relation("ImportPriceList")
  items            PriceItem[]
  analysisVersions AhspAnalysisVersion[]

  @@unique([projectId, versionNumber])
  @@map("price_lists")
}

model PriceItem {
  id            String  @id @default(uuid(7)) @db.Char(36)
  priceListId   String  @map("price_list_id") @db.Char(36)
  name          String  @db.VarChar(500)
  unit          String? @db.VarChar(30)
  price         Decimal @db.Decimal(40, 12)
  sourceLocator Json    @map("source_locator")
  /// Provenance when copied from another version's package (D-057).
  copiedFromId  String? @map("copied_from_id") @db.Char(36)

  priceList  PriceList       @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  copiedFrom PriceItem?      @relation("PriceItemCopy", fields: [copiedFromId], references: [id], onDelete: Restrict)
  copies     PriceItem[]     @relation("PriceItemCopy")
  components AhspComponent[]

  @@index([priceListId])
  @@map("price_items")
}

/// Identity in the single combined analysis list per project (D-045); the code is not an identity.
model AhspAnalysis {
  id           String   @id @default(uuid(7)) @db.Char(36)
  projectId    String   @map("project_id") @db.Char(36)
  /// Owner of the package (D-057).
  rabVersionId String   @map("rab_version_id") @db.Char(36)
  code         String?  @db.VarChar(50)
  name         String   @db.VarChar(1000)
  unit         String?  @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rabVersion RabVersion            @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  versions   AhspAnalysisVersion[]

  @@index([projectId, code])
  @@index([rabVersionId, code])
  @@map("ahsp_analyses")
}

enum AhspComponentCategory {
  LABOR
  MATERIAL
  EQUIPMENT
}

enum AhspSubPriceBasis {
  EXACT
  ROUNDED
}

/// RAB items point at a version (D-050, D-051). Source inputs change only while the owning RAB version is
/// DRAFT/REOPENED, through D-068 corrections that recalculate dependents and append `source_locator.corrections`.
model AhspAnalysisVersion {
  id              String   @id @default(uuid(7)) @db.Char(36)
  analysisId      String   @map("analysis_id") @db.Char(36)
  versionNumber   Int      @map("version_number") @db.UnsignedSmallInt
  priceListId     String   @map("price_list_id") @db.Char(36)
  /// Null for copies made by "Buat versi" (M4).
  sourceImportId  String?  @map("source_import_id") @db.Char(36)
  /// Provenance when copied from another version's package (D-057).
  copiedFromId    String?  @map("copied_from_id") @db.Char(36)
  /// Source snapshot: the original analysis name is never replaced by the recap name.
  code            String?  @db.VarChar(50)
  name            String   @db.VarChar(1000)
  unit            String?  @db.VarChar(30)
  discipline      String?  @db.VarChar(60)
  overheadPercent Decimal? @map("overhead_percent") @db.Decimal(9, 4)
  roundingScale   Int?     @map("rounding_scale") @db.TinyInt
  directCost      Decimal  @map("direct_cost") @db.Decimal(50, 24)
  overheadAmount  Decimal  @map("overhead_amount") @db.Decimal(50, 24)
  priceExact      Decimal  @map("price_exact") @db.Decimal(50, 24)
  price           Decimal  @db.Decimal(40, 12)
  sourceLocator   Json     @map("source_locator")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  analysis     AhspAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Restrict)
  priceList    PriceList             @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  sourceImport RabImport?            @relation(fields: [sourceImportId], references: [id], onDelete: Restrict)
  copiedFrom   AhspAnalysisVersion?  @relation("AnalysisVersionCopy", fields: [copiedFromId], references: [id], onDelete: Restrict)
  copies       AhspAnalysisVersion[] @relation("AnalysisVersionCopy")
  components   AhspComponent[]       @relation("ComponentOf")
  usedAsSub    AhspComponent[]       @relation("SubAnalysis")
  rabItems     RabVersionItem[]

  @@unique([analysisId, versionNumber])
  @@map("ahsp_analysis_versions")
}

model AhspComponent {
  id                   String                @id @default(uuid(7)) @db.Char(36)
  analysisVersionId    String                @map("analysis_version_id") @db.Char(36)
  sortOrder            Int                   @map("sort_order") @db.UnsignedSmallInt
  category             AhspComponentCategory
  description          String                @db.VarChar(1000)
  unit                 String?               @db.VarChar(30)
  coefficient          Decimal               @db.Decimal(30, 12)
  priceItemId          String?               @map("price_item_id") @db.Char(36)
  subAnalysisVersionId String?               @map("sub_analysis_version_id") @db.Char(36)
  subPriceBasis        AhspSubPriceBasis?    @map("sub_price_basis")
  unitPrice            Decimal               @map("unit_price") @db.Decimal(40, 12)
  amount               Decimal               @db.Decimal(65, 24)
  sourceLocator        Json                  @map("source_locator")

  analysisVersion    AhspAnalysisVersion  @relation("ComponentOf", fields: [analysisVersionId], references: [id], onDelete: Restrict)
  priceItem          PriceItem?           @relation(fields: [priceItemId], references: [id], onDelete: Restrict)
  subAnalysisVersion AhspAnalysisVersion? @relation("SubAnalysis", fields: [subAnalysisVersionId], references: [id], onDelete: Restrict)

  @@index([analysisVersionId, sortOrder])
  @@map("ahsp_components")
}

/// D-080: company-wide worker list. Deactivated, never deleted. KTP file is private under storage/workers/.
model Worker {
  id              String   @id @default(uuid(7)) @db.Char(36)
  name            String   @db.VarChar(150)
  position        String   @db.VarChar(150)
  nik             String   @unique @db.Char(16)
  ktpFilename     String?  @map("ktp_filename") @db.VarChar(64)
  ktpMimeType     String?  @map("ktp_mime_type") @db.VarChar(100)
  ktpFileSize     Int?     @map("ktp_file_size")
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String   @map("created_by") @db.Char(36)
  updatedBy       String   @map("updated_by") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  createdByUser User @relation("WorkerCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User @relation("WorkerUpdatedBy", fields: [updatedBy], references: [id])

  @@index([isActive, name])
  @@map("workers")
}

enum WeeklyReportStatus {
  DRAFT
  REVIEWED
  FINAL
  REOPENED
}

/// D-081: one weekly report per project week; content is computed live until FINAL, then read from the latest snapshot.
model WeeklyReport {
  id          String             @id @default(uuid(7)) @db.Char(36)
  projectId   String             @map("project_id") @db.Char(36)
  weekId      String             @unique @map("week_id") @db.Char(36)
  status      WeeklyReportStatus @default(DRAFT)
  submittedBy String             @map("submitted_by") @db.Char(36)
  submittedAt DateTime           @map("submitted_at") @db.DateTime(3)
  reviewedBy  String?            @map("reviewed_by") @db.Char(36)
  reviewedAt  DateTime?          @map("reviewed_at") @db.DateTime(3)
  reviewNote  String?            @map("review_note") @db.Text
  finalizedBy String?            @map("finalized_by") @db.Char(36)
  finalizedAt DateTime?          @map("finalized_at") @db.DateTime(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  week            ProjectWeek            @relation(fields: [weekId], references: [id], onDelete: Restrict)
  submittedByUser User                   @relation("WeeklySubmittedBy", fields: [submittedBy], references: [id])
  reviewedByUser  User?                  @relation("WeeklyReviewedBy", fields: [reviewedBy], references: [id])
  finalizedByUser User?                  @relation("WeeklyFinalizedBy", fields: [finalizedBy], references: [id])
  snapshots       WeeklyReportSnapshot[]

  @@index([projectId, status])
  @@map("weekly_reports")
}

/// D-081 butir 4: immutable content of a FINAL weekly report; a reopen keeps it, the next final adds one.
model WeeklyReportSnapshot {
  id             String   @id @default(uuid(7)) @db.Char(36)
  weeklyReportId String   @map("weekly_report_id") @db.Char(36)
  payload        Json
  createdBy      String   @map("created_by") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  weeklyReport  WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Restrict)
  createdByUser User         @relation(fields: [createdBy], references: [id])

  @@index([weeklyReportId, createdAt])
  @@map("weekly_report_snapshots")
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

/// D-082: per-project layout of one report type; `config` is validated by the API (shared reportTemplateSchema).
model ReportTemplate {
  id         String     @id @default(uuid(7)) @db.Char(36)
  projectId  String     @map("project_id") @db.Char(36)
  reportType ReportType @map("report_type")
  config     Json
  updatedBy  String     @map("updated_by") @db.Char(36)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  updatedByUser User    @relation(fields: [updatedBy], references: [id])

  @@unique([projectId, reportType])
  @@map("report_templates")
}

enum ReportLogoKind {
  AGENCY
  CONSULTANT
  CONTRACTOR
}

/// D-082 butir 3: one logo per kind per project; the file lives under storage/projects/<id>/logos/.
model ProjectLogo {
  id        String         @id @default(uuid(7)) @db.Char(36)
  projectId String         @map("project_id") @db.Char(36)
  kind      ReportLogoKind
  filename  String         @db.VarChar(64)
  mimeType  String         @map("mime_type") @db.VarChar(100)
  fileSize  Int            @map("file_size")
  updatedBy String         @map("updated_by") @db.Char(36)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  updatedByUser User    @relation(fields: [updatedBy], references: [id])

  @@unique([projectId, kind])
  @@map("project_logos")
}

/// D-086: the office's own Excel workbook per report type; exports fill its input cells and keep everything else.
model ReportWorkbook {
  id           String     @id @default(uuid(7)) @db.Char(36)
  projectId    String     @map("project_id") @db.Char(36)
  reportType   ReportType @map("report_type")
  filename     String     @db.VarChar(64)
  originalName String     @map("original_name") @db.VarChar(255)
  fileSize     Int        @map("file_size")
  updatedBy    String     @map("updated_by") @db.Char(36)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  updatedByUser User    @relation(fields: [updatedBy], references: [id])

  @@unique([projectId, reportType])
  @@map("report_workbooks")
}
