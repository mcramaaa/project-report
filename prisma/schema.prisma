// Base schema Milestone 1 (docs/DATABASE.md §1, D-028).
generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RoleScope {
  GLOBAL
  PROJECT
}

model User {
  id            String   @id @default(uuid(7)) @db.Char(36)
  name          String   @db.VarChar(150)
  /// Normalized (trim + lowercase) before write; uniqueness enforced here.
  email         String   @unique @db.VarChar(254)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  isSystemAdmin Boolean  @default(false) @map("is_system_admin")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sessions             AuthSession[]
  memberships          ProjectUser[]    @relation("MembershipUser")
  createdMemberships   ProjectUser[]    @relation("MembershipCreatedBy")
  revokedMemberships   ProjectUser[]    @relation("MembershipRevokedBy")
  globalRoles          UserGlobalRole[] @relation("GlobalRoleUser")
  createdGlobalRoles   UserGlobalRole[] @relation("GlobalRoleCreatedBy")
  revokedGlobalRoles   UserGlobalRole[] @relation("GlobalRoleRevokedBy")
  auditLogs            AuditLog[]
  createdRabVersions   RabVersion[]     @relation("RabVersionCreatedBy")
  approvedRabVersions  RabVersion[]     @relation("RabVersionApprovedBy")
  discardedRabVersions RabVersion[]     @relation("RabVersionDiscardedBy")

  @@index([isSystemAdmin, isActive])
  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// SHA-256 hex of the session token; the raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model Project {
  id              String        @id @default(uuid(7)) @db.Char(36)
  code            String        @unique @db.VarChar(50)
  activityName    String        @map("activity_name") @db.VarChar(255)
  subActivityName String        @map("sub_activity_name") @db.VarChar(255)
  projectName     String        @map("project_name") @db.VarChar(500)
  location        String        @db.VarChar(255)
  fiscalYear      Int           @map("fiscal_year") @db.UnsignedSmallInt
  contractorName  String        @map("contractor_name") @db.VarChar(255)
  consultantName  String        @map("consultant_name") @db.VarChar(255)
  contractNumber  String        @map("contract_number") @db.VarChar(100)
  contractDate    DateTime      @map("contract_date") @db.Date
  /// Required by the API; null only for projects created before Milestone 3 (D-039).
  contractValue   Decimal?      @map("contract_value") @db.Decimal(20, 2)
  spmkNumber      String        @map("spmk_number") @db.VarChar(100)
  spmkDate        DateTime      @map("spmk_date") @db.Date
  startDate       DateTime      @map("start_date") @db.Date
  /// Planned finish date is derived (start + duration − 1) and not stored (D-036).
  durationDays    Int           @map("duration_days") @db.UnsignedSmallInt
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  members       ProjectUser[]
  auditLogs     AuditLog[]
  weeks         ProjectWeek[]
  reportPeriods ReportPeriod[]
  rabVersions   RabVersion[]
  workItems     WorkItem[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// 7-day blocks from the project start; the last one ends on the planned finish date (D-037).
model ProjectWeek {
  id             String   @id @default(uuid(7)) @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  reportPeriodId String   @map("report_period_id") @db.Char(36)
  weekNumber     Int      @map("week_number") @db.UnsignedSmallInt
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reportPeriod ReportPeriod @relation(fields: [reportPeriodId], references: [id], onDelete: Restrict)

  @@unique([projectId, weekNumber])
  @@index([reportPeriodId])
  @@map("weeks")
}

/// 4-week blocks (B.n = weeks 4n−3..4n); the last one may be shorter than 28 days (D-037).
model ReportPeriod {
  id           String   @id @default(uuid(7)) @db.Char(36)
  projectId    String   @map("project_id") @db.Char(36)
  periodNumber Int      @map("period_number") @db.UnsignedSmallInt
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  weeks   ProjectWeek[]

  @@unique([projectId, periodNumber])
  @@map("report_periods")
}

/// Roles are data (D-035). System roles: code, scope, and isActive are locked.
model Role {
  id          String    @id @default(uuid(7)) @db.Char(36)
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  /// Inactive roles grant no permissions.
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  permissions       RolePermission[]
  memberships       ProjectUser[]
  globalAssignments UserGlobalRole[]

  @@map("roles")
}

/// permission_code refers to the code catalog in packages/shared (PERMISSIONS).
model RolePermission {
  roleId         String   @map("role_id") @db.Char(36)
  permissionCode String   @map("permission_code") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model ProjectUser {
  id        String    @id @default(uuid(7)) @db.Char(36)
  projectId String    @map("project_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// Must reference a PROJECT-scoped role (enforced in the service).
  roleId    String    @map("role_id") @db.Char(36)
  createdBy String?   @map("created_by") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// Soft revoke (D-029); active membership = revokedAt IS NULL.
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  revokedBy String?   @map("revoked_by") @db.Char(36)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user          User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User?   @relation("MembershipRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("project_users")
}

/// Administration role assignment without a project (D-035). Must reference a GLOBAL-scoped role.
model UserGlobalRole {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  roleId    String    @map("role_id") @db.Char(36)
  createdBy String?   @map("created_by") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  revokedBy String?   @map("revoked_by") @db.Char(36)

  user          User  @relation("GlobalRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByUser User? @relation("GlobalRoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("GlobalRoleRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_global_roles")
}

/// Append-only. Never store passwords, hashes, tokens, or secrets (D-034).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Char(36)
  projectId  String?  @map("project_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Char(36)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor   User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum RabVersionType {
  CONTRACT
  MC0
  ADDENDUM
}

enum RabVersionStatus {
  DRAFT
  APPROVED
  DISCARDED
}

/// Stored row types; SUBTOTAL/TOTAL are computed for display (D-040).
enum RabRowType {
  SECTION
  SUBSECTION
  PARENT_ITEM
  ITEM
}

/// One RAB version per document; APPROVED/DISCARDED rows are never changed (D-040).
model RabVersion {
  id                String           @id @default(uuid(7)) @db.Char(36)
  projectId         String           @map("project_id") @db.Char(36)
  versionType       RabVersionType   @map("version_type")
  /// 0 for CONTRACT/MC0; 1, 2, … for ADDENDUM.
  revisionNumber    Int              @map("revision_number") @db.UnsignedSmallInt
  documentNumber    String?          @map("document_number") @db.VarChar(100)
  documentDate      DateTime?        @map("document_date") @db.Date
  /// Approved version this one was copied from.
  previousVersionId String?          @map("previous_version_id") @db.Char(36)
  status            RabVersionStatus @default(DRAFT)
  /// Snapshot at approval (D-042); drafts are computed on read.
  totalBeforeTax    Decimal?         @map("total_before_tax") @db.Decimal(20, 2)
  totalTax          Decimal?         @map("total_tax") @db.Decimal(20, 2)
  totalValue        Decimal?         @map("total_value") @db.Decimal(20, 2)
  createdBy         String           @map("created_by") @db.Char(36)
  approvedBy        String?          @map("approved_by") @db.Char(36)
  approvedAt        DateTime?        @map("approved_at") @db.DateTime(3)
  discardedBy       String?          @map("discarded_by") @db.Char(36)
  discardedAt       DateTime?        @map("discarded_at") @db.DateTime(3)
  discardReason     String?          @map("discard_reason") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previousVersion RabVersion?      @relation("RabVersionChain", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions    RabVersion[]     @relation("RabVersionChain")
  createdByUser   User             @relation("RabVersionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedByUser  User?            @relation("RabVersionApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  discardedByUser User?            @relation("RabVersionDiscardedBy", fields: [discardedBy], references: [id], onDelete: Restrict)
  items           RabVersionItem[]

  @@index([projectId, status])
  @@map("rab_versions")
}

/// Permanent identity of a trackable work item across versions (PRD §9).
model WorkItem {
  id                   String   @id @default(uuid(7)) @db.Char(36)
  projectId            String   @map("project_id") @db.Char(36)
  internalCode         String   @map("internal_code") @db.VarChar(20)
  canonicalDescription String   @map("canonical_description") @db.VarChar(1000)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionItems RabVersionItem[]

  @@unique([projectId, internalCode])
  @@map("work_items")
}

model RabVersionItem {
  id                    String     @id @default(uuid(7)) @db.Char(36)
  rabVersionId          String     @map("rab_version_id") @db.Char(36)
  /// ITEM rows only.
  workItemId            String?    @map("work_item_id") @db.Char(36)
  parentItemId          String?    @map("parent_item_id") @db.Char(36)
  sortOrder             Int        @map("sort_order") @db.UnsignedInt
  rowType               RabRowType @map("row_type")
  displayNumber         String?    @map("display_number") @db.VarChar(30)
  description           String     @db.VarChar(1000)
  volume                Decimal?   @db.Decimal(18, 4)
  unit                  String?    @db.VarChar(30)
  /// Free-text "no analisa" until AHSP (M7).
  analysisCode          String?    @map("analysis_code") @db.VarChar(50)
  unitPrice             Decimal?   @map("unit_price") @db.Decimal(20, 2)
  taxPercent            Decimal?   @map("tax_percent") @db.Decimal(5, 2)
  /// Snapshot at approval (D-042).
  unitPriceWithTax      Decimal?   @map("unit_price_with_tax") @db.Decimal(20, 2)
  subtotal              Decimal?   @db.Decimal(20, 2)
  weight                Decimal?   @db.Decimal(12, 6)
  previousVersionItemId String?    @map("previous_version_item_id") @db.Char(36)
  createdAt             DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  rabVersion          RabVersion       @relation(fields: [rabVersionId], references: [id], onDelete: Restrict)
  workItem            WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  parent              RabVersionItem?  @relation("RabItemTree", fields: [parentItemId], references: [id], onDelete: Restrict)
  children            RabVersionItem[] @relation("RabItemTree")
  previousVersionItem RabVersionItem?  @relation("RabItemCopy", fields: [previousVersionItemId], references: [id], onDelete: Restrict)
  copies              RabVersionItem[] @relation("RabItemCopy")

  @@unique([rabVersionId, workItemId])
  @@index([rabVersionId, parentItemId, sortOrder])
  @@map("rab_version_items")
}
