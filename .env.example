# Copy to .env and replace every placeholder. .env is git-ignored.

# MySQL container (docker-compose.yml). Only applied when the volume is first created.
MYSQL_PASSWORD="change_me"
MYSQL_ROOT_PASSWORD="change_root_me"

# App database. The test suite derives <database>_test from this URL.
DATABASE_URL="mysql://laporan:change_me@localhost:3306/laporan_proyek"
# Only needed for `npm run db:migrate:dev` (creating new migrations).
SHADOW_DATABASE_URL="mysql://laporan:change_me@localhost:3306/laporan_proyek_shadow"

# Public origin of apps/web. Used for the CSRF Origin check and cookie Secure flag.
APP_URL="http://localhost:3000"
# Where apps/web (server side + /api rewrite) reaches apps/api.
API_URL="http://localhost:3001"
PORT=3001
SESSION_TTL_HOURS=12

# First system admin, used by `npm run db:seed` only when the email does not exist yet.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD=""

STORAGE_ROOT="./storage"

NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_API_KEY=""
AI_MODEL=""
